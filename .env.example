# ---- 必填 ----
# 会话签名与 S3 密钥加密用的随机字符串（至少 32 位）。上线后不要随意更换，
# 否则所有用户需要重新登录，且后台保存的 S3 Secret 需要重新填写。
SECRET_KEY=change-me-to-a-long-random-string

# Postgres 连接串。Vercel 集成 Neon 后会自动注入 DATABASE_URL / POSTGRES_URL。
# 本地不填则使用 data/vault.sqlite3
DATABASE_URL=

# 首次启动时自动创建的管理员账号（已存在管理员时忽略）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123

# ---- 可选：S3 也可以在后台「存储设置」里填写，后台配置优先 ----
S3_BUCKET=
S3_REGION=ap-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=modelvault/
# S3 兼容服务（如 Cloudflare R2 / MinIO）才需要填写
S3_ENDPOINT=

# 其他
APP_TIMEZONE=Asia/Shanghai
MAX_GLB_MB=1024
SESSION_DAYS=7
